    <color name="cw_blue_dark">#052F4D</color>
    <color name="cw_green">#1E5638</color>
    <color name="cw_orange">#B44D0D</color>
    <color name="cw_white">#FFFFFF</color>
    <color name="cw_grey_ultra_light">#F2F2F2</color>
</resources>
