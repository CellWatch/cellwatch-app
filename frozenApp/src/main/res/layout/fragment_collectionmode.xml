<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true" >

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/collection_mode"
        android:gravity="center"
        android:textColor="@color/cw_blue"
        android:textSize="36sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/collection_mode_description"
        android:textSize="16sp"
        android:textColor="@color/cw_black"
        android:layout_marginTop="16dp"
        android:gravity="center"/>

    <LinearLayout
        android:id="@+id/LLReadPrivacyPolicy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:clickable="true"
        android:layout_marginBottom="16dp" >

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/fa_solid_user_lock" />

        <TextView
            android:id="@+id/readPrivacyPolicy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/read_privacy_policy"
            android:textColor="#000000"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- FCC Challenge Mode Box -->
    <LinearLayout
        android:id="@+id/flFCCChallengeMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/selectable_button_bg"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fcc_challenge_mode"
                android:textSize="20sp"
                android:textColor="@color/cw_green"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fcc_challenge_mode_description"
                android:textSize="16sp"
                android:textColor="@color/cw_black"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/fccModeCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="12dp"
            app:tint="@color/cw_green"
            android:src="@drawable/fa_solid_check" />
    </LinearLayout>

    <!-- Testing Mode Box -->
    <LinearLayout
        android:id="@+id/flTestingMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/selectable_button_bg"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/testing_mode"
                android:textSize="20sp"
                android:textColor="@color/cw_green"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/testing_mode_description"
                android:textSize="16sp"
                android:textColor="@color/cw_black"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/testingModeCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="12dp"
            app:tint="@color/cw_green"
            android:src="@drawable/fa_solid_check" />
    </LinearLayout>

</LinearLayout>
</ScrollView>