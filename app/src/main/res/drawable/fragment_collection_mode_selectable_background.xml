<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- When selected -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#90EE90"/> <!-- light green background -->
            <stroke android:width="2dp" android:color="#006400"/> <!-- dark green border -->
        </shape>
    </item>
    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/> <!-- Default background color -->
            <stroke android:width="2dp" android:color="#006400"/> <!-- dark green border -->
        </shape>
    </item>
</selector>