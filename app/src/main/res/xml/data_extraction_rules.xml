<?xml version="1.0" encoding="utf-8"?><!--
   Nothing the app stores is backed up or copied to a new phone.

   The device secret is encrypted with an Android Keystore key, and Keystore keys never leave the
   phone. A copy of the app's files on another phone can't decrypt the secret, so that phone could
   never upload. From Android 12, some phones copy app data to a new phone even with
   android:allowBackup="false", unless these rules exclude it. With them, the new phone starts
   fresh and registers as a new device.

   See https://developer.android.com/identity/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
