<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@+id/MapActivity">

    <fragment
        android:id="@+id/MeasurementFragment"
        android:name="com.cellwatch.ui.measurement.MeasurementFragment"
        tools:layout="@layout/fragment_measurement">
        <action
            android:id="@+id/action_MeasurementFragment_to_mapActivity"
            app:destination="@id/mapActivity" />
    </fragment>
    <activity
        android:id="@+id/mapActivity"
        android:name="com.cellwatch.ui.map.MapActivity"
        android:label="MapActivity"
        tools:layout="@layout/activity_map" />
    <activity
        android:id="@+id/mainActivity"
        android:name="com.cellwatch.ui.main.MainActivity"
        android:label="activity_main"
        tools:layout="@layout/activity_main" />
</navigation>