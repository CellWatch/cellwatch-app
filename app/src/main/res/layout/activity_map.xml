<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- MapView from Mapbox -->
            <com.mapbox.maps.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:mapbox_cameraTargetLat="40.7128"
                app:mapbox_cameraTargetLng="-74.0060"
                app:mapbox_cameraZoom="9.0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/search_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                android:paddingHorizontal="8dp"
                android:elevation="10dp"
                android:background="@drawable/rectangle_rounded"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageButton
                    android:id="@+id/sideMenuButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="16dp"
                    android:background="?android:selectableItemBackground"
                    android:contentDescription="@string/menu"
                    android:src="@drawable/fa_solid_bars"
                    app:tint="@color/cw_blue" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="4dp"
                    android:src="@drawable/fa_solid_search"
                    app:tint="@color/cw_blue" />

                <EditText
                    android:id="@+id/query_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:background="@color/cw_white"
                    android:textColorHint="@color/cw_blue"
                    android:hint="@string/search_map"
                    android:textColor="@color/cw_black"
                    android:inputType="text" />
            </LinearLayout>

            <com.mapbox.search.ui.view.SearchResultsView
                android:id="@+id/search_results_view"
                android:theme="@style/CustomSearchSdkTheme"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:elevation="20dp"
                android:background="@color/cw_white"
                android:paddingVertical="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/search_container"
                app:layout_constraintStart_toStartOf="@id/search_container"
                app:layout_constraintTop_toBottomOf="@id/search_container" />

            <!-- LinearLayout for action buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:padding="6dp"
                android:background="@drawable/rectangle_rounded"
                android:elevation="10dp"
                android:gravity="center|top"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/search_container">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/h3ToggleSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumb="@drawable/switch_thumb_hex"
                    app:track="@drawable/switch_track_green" />

                <ImageButton
                    android:id="@+id/centerUserButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginBottom="8dp"
                    android:background="@null"
                    android:backgroundTint="@color/cw_white"
                    android:elevation="0dp"
                    android:src="@drawable/fa_solid_location_crosshairs"
                    app:tint="@color/cw_green" />
            </LinearLayout>

            <Button
                android:id="@+id/measureButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                android:paddingVertical="10dp"
                android:paddingHorizontal="16dp"
                android:backgroundTint="@color/cw_white"
                android:drawableLeft="@drawable/fa_solid_plus"
                android:text="@string/add_measurement"
                android:textSize="20sp"
                android:textAllCaps="false"
                android:textColor="@color/cw_green"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:behavior_hideable="true"
            app:behavior_peekHeight="200dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            android:background="@drawable/measurement_card_background">

            <View
                android:id="@+id/sheetHandle"
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:layout_marginVertical="8dp"
                android:background="@drawable/sheet_handle" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/sheetHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <ImageButton
                    android:id="@+id/sheetCloseBtn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/fa_solid_chevron_left"
                    app:tint="@color/cw_blue"
                    android:background="#00000000"
                    android:contentDescription="@string/close"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/sheetTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/hex"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/cw_blue"
                    android:layout_marginHorizontal="32dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sheetContents"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp"
                android:scrollbars="vertical" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <edu.gatech.cc.cellwatch.ui.main.NavigationDrawer
        android:id="@+id/navDrawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
