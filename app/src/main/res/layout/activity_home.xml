<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/back_arrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/circle_filled"
            android:padding="12dp"
            android:contentDescription="@string/previous"
            app:tint="@color/cw_blue"
            android:src="@drawable/fa_solid_chevron_left" />

        <ImageView
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="6dp"
            app:tint="@color/cw_grey_light"
            android:src="@drawable/circle_filled" />

        <ImageView
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="6dp"
            app:tint="@color/cw_grey_light"
            android:src="@drawable/circle_filled" />

        <ImageView
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="6dp"
            app:tint="@color/cw_grey_light"
            android:src="@drawable/circle_filled" />

        <ImageView
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="6dp"
            app:tint="@color/cw_grey_light"
            android:src="@drawable/circle_filled" />

        <ImageButton
            android:id="@+id/forward_arrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/circle_filled"
            android:padding="12dp"
            android:contentDescription="@string/next"
            app:tint="@color/cw_blue"
            android:src="@drawable/fa_solid_chevron_right" />
    </LinearLayout>

</LinearLayout>
