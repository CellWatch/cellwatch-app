<?xml version="1.0" encoding="utf-8"?>


<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <!-- MapView from Mapbox -->
        <com.mapbox.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:mapbox_cameraTargetLat="40.7128"
            app:mapbox_cameraTargetLng="-74.0060"
            app:mapbox_cameraZoom="9.0"
            app:layout_editor_absoluteX="-16dp"
            app:layout_editor_absoluteY="16dp" >
        </com.mapbox.maps.MapView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginRight="30dp"
            android:layout_marginLeft="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="horizontal"
            android:padding="16dp"
            android:elevation="10dp"
            android:layout_gravity="top"
            android:background="#FFFFFF">

            <ImageButton
                android:id="@+id/sideMenuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:background="?android:selectableItemBackground"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu"
                app:tint="@color/mapbox_blue" />

            <!-- Search button -->
            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_search"
                android:background="?android:selectableItemBackground"
                android:contentDescription="Search"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="30dp"
                app:tint="@color/mapbox_blue"/>

            <!-- Search EditText -->
            <EditText
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:hint="@string/search_map"
                android:background="@android:color/transparent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_weight="1"
                android:inputType="text"
                android:importantForAutofill="no" />
        </LinearLayout>

        <!-- LinearLayout for action buttons -->
        <LinearLayout
            android:layout_width="77dp"
            android:layout_height="128dp"
            android:layout_marginTop="125dp"
            android:layout_marginEnd="20dp"
            android:background="@color/white"
            android:elevation="0dp"
            android:gravity="center|top"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/centerUserButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:backgroundTint="@color/white"
                android:elevation="0dp"
                app:icon="@drawable/location_icon"
                app:iconSize="50dp"
                app:iconTint="@color/green"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/button1"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/h3ToggleSwitch"
                android:layout_width="wrap_content"
                android:checked="false"
                android:layout_height="wrap_content"
                android:scaleX="1.5"
                android:scaleY="1.5"
                app:thumbTint="@color/white"
                app:trackTint="@color/green" />

        </LinearLayout>
        <Button
            android:id="@+id/measureButton"
            android:layout_width="160dp"
            android:layout_height="73dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="@color/white"
            android:text="@string/add_measurement"
            android:textSize="20sp"
            android:textColor="@color/green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.drawerlayout.widget.DrawerLayout>