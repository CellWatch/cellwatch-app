<?xml version="1.0" encoding="utf-8"?>
<!-- NavigationView for the side menu -->
<com.google.android.material.navigation.NavigationView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="start">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingVertical="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_horizontal"
        android:background="@color/cw_blue">

        <!-- Close button at the top left -->
        <ImageButton
            android:id="@+id/menuCloseButton"
            android:background="@color/cw_blue"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/fa_solid_xmark"
            android:contentDescription="@string/close"
            android:layout_gravity="start|center"
            app:tint="@color/cw_white"/>

        <Button
            android:id="@+id/mapButton"
            style="@style/SideMenuButton"
            app:icon="@drawable/fa_solid_map_location_dot"
            android:text="@string/map" />

        <Button
            android:id="@+id/menuMeasureButton"
            style="@style/SideMenuButton"
            app:icon="@drawable/fa_solid_gauge_high"
            android:text="@string/measure" />

        <Button
            android:id="@+id/historyButton"
            style="@style/SideMenuButton"
            app:icon="@drawable/fa_solid_clock"
            android:text="@string/measurement_history" />

        <Button
            android:id="@+id/settingsButton"
            style="@style/SideMenuButton"
            app:icon="@drawable/fa_solid_gear"
            android:text="@string/settings" />

        <Button
            android:id="@+id/helpButton"
            style="@style/SideMenuButton"
            app:icon="@drawable/fa_circle_about"
            android:text="@string/about" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginEnd="8dp"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/cw_white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="@string/app_name" />
    </LinearLayout>

</com.google.android.material.navigation.NavigationView>