<resources>
    <style name="Theme.CellWatch" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="android:colorBackground">@color/cw_grey_ultra_light</item>

        <item name="colorSurface">@color/cw_white</item>
        <item name="colorOnSurface">@color/cw_black</item>
        <item name="colorPrimarySurface">@color/cw_white</item>
        <item name="colorOnPrimarySurface">@color/cw_black</item>

        <item name="colorPrimary">@color/cw_green</item>
        <item name="colorPrimaryDark">@color/cw_green</item>
        <item name="colorPrimaryVariant">@color/cw_green_light</item>
        <item name="colorOnPrimary">@color/cw_white</item>

        <item name="colorSecondary">@color/cw_blue</item>
        <item name="colorSecondaryVariant">@color/cw_blue</item>
        <item name="colorOnSecondary">@color/cw_white</item>

        <item name="android:statusBarColor">?attr/colorPrimaryDark</item>
        <item name="mapboxSearchSdkTheme">@style/CustomSearchSdkTheme</item>
    </style>

    <style name="Theme.CellWatch.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- https://docs.mapbox.com/android/search/guides/search-ui/customisations/ -->
    <style name="CustomSearchSdkTheme" parent="">
        <item name="mapboxSearchSdkPrimaryTextColor">@color/cw_blue</item>
        <item name="mapboxSearchSdkPrimaryTextInactiveColor">@color/cw_grey</item>
        <item name="mapboxSearchSdkPrimaryAccentColor">#34431F</item>
        <item name="mapboxSearchSdkOnPrimaryAccentColor">#D3C9A6</item>
        <item name="mapboxSearchSdkDistanceColor">#A1AE7E</item>
        <item name="mapboxSearchSdkIconTintColor">@color/cw_black</item>
        <item name="mapboxSearchSdkBackgroundColor">@color/cw_grey</item>
        <item name="mapboxSearchSdkBackgroundSecondaryColor">#AFC3AD</item>
        <item name="mapboxSearchSdkPopulateArrowColor">#D3C9A6</item>
        <item name="mapboxSearchSdkProgressColor">#4F6530</item>
        <item name="mapboxSearchSdkErrorIconColor">#4F6530</item>
    </style>
</resources>