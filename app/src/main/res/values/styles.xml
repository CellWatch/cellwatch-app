<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BaseButtonAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">5dp</item>
    </style>

    <style name="GreenButton" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="shapeAppearance">@style/BaseButtonAppearance</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:backgroundTint">@color/cw_green</item>
        <item name="android:textColor">@color/cw_white</item>
        <item name="iconTint">@color/cw_white</item>
    </style>

    <style name="PlainButton" parent="@style/Widget.MaterialComponents.Button.OutlinedButton">
        <item name="shapeAppearance">@style/BaseButtonAppearance</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textColor">@color/cw_black</item>
        <item name="strokeColor">@color/cw_grey_dark</item>
        <item name="iconTint">@color/cw_black</item>
    </style>

    <style name="TextInputLayout" parent="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeColor">@color/cw_green</item>
        <item name="boxBackgroundColor">@color/cw_white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="TextInput" parent="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="android:textColor">@color/cw_black</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="TextInputLayoutDropdown" parent="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/cw_green</item>
        <item name="boxBackgroundColor">@color/cw_white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="endIconTint">@color/cw_green</item>
    </style>

    <style name="SideMenuButtonAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">5dp</item>
        <item name="cornerSizeBottomRight">5dp</item>
    </style>

    <style name="SideMenuButton" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:elevation">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textColor">@color/cw_white</item>
        <item name="iconTint">@color/cw_white</item>
        <item name="iconPadding">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="shapeAppearance">@style/SideMenuButtonAppearance</item>
        <item name="android:backgroundTint">@color/cw_blue</item>
    </style>

    <style name="Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="navigationIcon">@drawable/fa_solid_bars</item>
        <item name="navigationContentDescription">@string/menu</item>
        <item name="titleTextColor">@color/cw_blue</item>
        <item name="title">@string/measure</item>
        <item name="titleTextAppearance">@style/Toolbar.TitleText</item>
        <item name="android:theme">@style/ThemeOverlay.AppCompat.ActionBar</item>
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Light</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
    </style>

    <style name="Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/cw_blue</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>